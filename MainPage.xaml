<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:esri="clr-namespace:Esri.ArcGISRuntime.Maui;assembly=Esri.ArcGISRuntime.Maui"
    x:Class="ArcGISMaui1000PointsSample.MainPage"
    Title="Incident Dashboard">

    <Grid>
        <esri:MapView x:Name="mapView" />

        <!-- Top dashboard card -->
        <Frame
            Margin="15,15,15,0"
            Padding="14"
            CornerRadius="14"
            BackgroundColor="#CCFFFFFF"
            HasShadow="True"
            VerticalOptions="Start"
            HorizontalOptions="Start"
            WidthRequest="280">

            <VerticalStackLayout Spacing="8">
                <Label
                    Text="Incident Dashboard"
                    FontSize="22"
                    FontAttributes="Bold"
                    TextColor="#1F2937" />

                <Label
                    Text="1000 simulated incidents across the U.S."
                    FontSize="13"
                    TextColor="#4B5563" />

                <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="14">
                    <Label Grid.Column="0" Text="● Fire" TextColor="Red" FontAttributes="Bold" />
                    <Label Grid.Column="1" Text="● Police" TextColor="Blue" FontAttributes="Bold" />
                    <Label Grid.Column="2" Text="● EMS" TextColor="Green" FontAttributes="Bold" />
                </Grid>
            </VerticalStackLayout>
        </Frame>

        <!-- Bottom info card -->
        <Frame
            Margin="15"
            Padding="12"
            CornerRadius="14"
            BackgroundColor="#CCFFFFFF"
            HasShadow="True"
            VerticalOptions="End"
            HorizontalOptions="End"
            WidthRequest="190">

            <VerticalStackLayout Spacing="4">
                <Label
                    Text="Tip"
                    FontSize="16"
                    FontAttributes="Bold"
                    TextColor="#111827" />

                <Label
                    Text="Tap any point to see incident details."
                    FontSize="13"
                    TextColor="#4B5563" />
            </VerticalStackLayout>
        </Frame>
    </Grid>

</ContentPage>